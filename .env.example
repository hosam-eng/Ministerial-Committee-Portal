# Local development values only — copy to .env (gitignored).
# Never put production credentials in this file or in .env committed anywhere.

# Application runtime connection (least-privilege role).
DATABASE_URL=postgresql://mcp_runtime:mcp_runtime_dev@127.0.0.1:5432/mcp_dev

# Prisma CLI migration commands (schema-evolution role).
DATABASE_MIGRATION_URL=postgresql://mcp_migrate:mcp_migrate_dev@127.0.0.1:5432/mcp_dev

# Deployment environment (REQUIRED — no default): development | test | production.
# DATABASE_URL is required when APP_ENV=production.
APP_ENV=development

# Pino log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# OpenTelemetry service name. No exporter is attached unless the
# OTLP HTTP endpoint below is set — local dev needs no backend.
OTEL_SERVICE_NAME=ministerial-committee-portal
OTEL_EXPORTER_OTLP_ENDPOINT=

# Better Auth (IMP-05).
# BETTER_AUTH_SECRET: signing/encryption secret — REQUIRED in every
# environment (min 32 chars). The value below is a local-development
# placeholder ONLY — generate a unique random secret per environment and
# never reuse this placeholder in test/production. Never log or expose it.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-32chars
# Absolute base URL of the auth server — REQUIRED in every environment
# (Better Auth never infers its origin from request headers). http is
# allowed in development/test; production requires https.
BETTER_AUTH_URL=http://localhost:3000

# Development-only local user bootstrap (npm run auth:create-local-user).
# Hard-fails unless APP_ENV=development. Never commit real credentials.
# LOCAL_ADMIN_EMAIL=
# LOCAL_ADMIN_PASSWORD=
